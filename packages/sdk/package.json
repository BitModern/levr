{
  "name": "@levr-one/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Levr API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "author": "BitModern",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BitModern/levr.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/BitModern/levr/issues"
  },
  "homepage": "https://github.com/BitModern/levr/tree/main/packages/sdk#readme"
}
