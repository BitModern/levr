# Public-repo .gitignore (copied to the export root as `.gitignore`).
node_modules/
dist/
# ...EXCEPT the PRE-BUILT packages (registry `keepDist`, e.g. cli and sdk): their
# bundled, brand-scrubbed dist/ is built in the monorepo and copied verbatim (the
# mirror can't rebuild it), so it MUST be committed or the published package
# ships empty. Those `!packages/<dir>/dist/` exceptions are APPENDED by
# scripts/export/levr.mjs from the registry, never hand-listed here. auth still
# rebuilds in the mirror, so its dist/ stays ignored.
*.tgz
*.log
.DS_Store
.turbo/

# Prebuilt packages (registry keepDist): their bundled dist/ IS the
# published artifact and must be committed. Generated by the export.
!packages/cli/dist/
!packages/cli/dist/**
!packages/sdk/dist/
!packages/sdk/dist/**
